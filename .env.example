# Local development only. Run `make env` to generate a private .env.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
POSTGRES_DB=journey
POSTGRES_USER=journey
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_PORT=55432
TEST_DB_PORT=55433
API_PORT=8080
DATABASE_URL=postgres://journey:REPLACE_WITH_RANDOM_HEX@127.0.0.1:55432/journey?sslmode=disable
# Optional Compose overrides. Production: use distinct non-admin API and DDL migration roles.
API_DATABASE_URL=
MIGRATION_DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=
COOKIE_SECURE=false
SESSION_TTL=168h
INVITATION_TTL=72h
AUTH_RATE_PER_MINUTE=10
DB_MAX_CONNECTIONS=10
# Phase 2; never prefix these secrets with VITE_.
ORS_BASE_URL=https://api.heigit.org/openrouteservice
GEOCODING_BASE_URL=https://api.heigit.org/pelias/v1
HEIGIT_API_KEY=
